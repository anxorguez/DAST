# ============================================================
# DAST Framework - Environment Variables
# Copy this file to .env and adjust values before starting.
# Never commit .env to version control.
# ============================================================

# --- Target ---
TARGET_URL=http://dvwa

# --- Output ---
OUTPUT_DIR=/app/reports
LOG_LEVEL=INFO

# --- Crawler ---
MAX_DEPTH=3
MAX_PAGES=100
REQUEST_TIMEOUT=30
CONCURRENT_PAGES=5

# --- Authentication (optional pre-scan login) ---
AUTH_ENABLED=false
AUTH_URL=http://dvwa/login.php
AUTH_USERNAME=admin
AUTH_PASSWORD=password
AUTH_USERNAME_FIELD=username
AUTH_PASSWORD_FIELD=password
AUTH_SUCCESS_URL=http://dvwa/index.php

# --- Fuzzing ---
# Default: full coverage across the eight implemented scanner classes.
PAYLOAD_TYPES=sqli,xss,cmdi,ssrf,xxe,deserialization,path_traversal,open_redirect
MAX_PAYLOADS_PER_VECTOR=50
CONCURRENT_VECTORS=5
CONCURRENT_PAYLOADS=10
REQUESTS_PER_SECOND=0

# --- cf_clearance bridge ---
# When true, the fuzzer will re-trigger Playwright to refresh the
# cf_clearance cookie if an upstream responds with X-Cf-Sim-Challenge.
# Required only when scanning targets behind a cf_clearance-style
# challenge (e.g. the cf-sim test fixture).
CF_CLEARANCE_BRIDGE_ENABLED=false

# --- Database ---
# Leave empty to auto-generate per scan inside the scan output folder.
DB_PATH=

# --- DVWA test target (used by integration tests) ---
DVWA_SECURITY_LEVEL=low
DVWA_USERNAME=admin
DVWA_PASSWORD=password
